{
    "name": "se7enxweb/git_manager",
    "description": "Git Manager for Exponential: check out branches and commits, compare with the upstream branch, push, manage remotes and submodules, and make, encrypt and download site backups from the administration, without shell access.",
    "type": "ezpublish-legacy-extension",
    "keywords": [
        "exponential",
        "exponential-legacy",
        "ezpublish-legacy",
        "extension",
        "git",
        "deployment",
        "backup",
        "gpg",
        "mysqldump",
        "admin"
    ],
    "homepage": "https://github.com/se7enxweb/git_manager",
    "support": {
        "issues": "https://github.com/se7enxweb/git_manager/issues",
        "source": "https://github.com/se7enxweb/git_manager"
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Serhey Dolgushev",
            "homepage": "https://ua.linkedin.com/in/serheydolgushev",
            "role": "Author"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com",
            "homepage": "https://se7enx.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "suggest": {
        "ext-posix": "Lets the Upstream card name the user the site runs as and, run as root, fetch as the owner of the repository.",
        "ext-mbstring": "Cuts long log filter texts at a character boundary."
    },
    "extra": {
        "ezpublish-legacy-extension-name": "git_manager",
        "installer-name": "git_manager"
    }
}
