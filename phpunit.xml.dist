<?xml version="1.0" encoding="UTF-8"?>
<!--
  The git_manager unit tests: the backup catalogue, how fresh the backups are and the texts that say so.
  No database, no request, no Exponential root needed: the classes under test are plain PHP.
  Run (from extension/git_manager, or this checkout): php ../../vendor/bin/phpunit
  or with any PHPUnit 10 or later: phpunit -c phpunit.xml.dist
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="false"
         cacheDirectory="tests/.phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
